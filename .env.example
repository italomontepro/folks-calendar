PORT=3001
DATA_DIR=./data
# Administrador global inicial. Obrigatórios no primeiro boot em produção.
# Na migração, APP_PASSWORD pode ser a senha da agenda que você já utiliza.
ADMIN_EMAIL=
APP_PASSWORD=
# Depois do primeiro boot, contas/senhas ficam no banco. Alterar estas variáveis não redefine o login.
# Origens globais de incorporação. Prefira cadastrar o HELENA em cada workspace na interface.
FRAME_ANCESTORS='self'
# Configure apenas se o servidor estiver atrás de um proxy confiável (ex.: Traefik no EasyPanel).
# TRUST_PROXY_HOPS=1
# URL pública do servidor. Base do callback do Google quando GOOGLE_REDIRECT_URI não for definido.
PUBLIC_URL=http://localhost:3001
# Google Calendar OAuth (Google Cloud OAuth client, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-dominio/api/google/callback
